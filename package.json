{
  "name": "prompt-provenance-readme-generator",
  "version": "0.1.0",
  "description": "Generate a human-readable Markdown README from a prompt-provenance JSON document (per prompt-provenance-spec v0.1). Renders identity, approval state, lineage chain, authorship, intent (in/out of scope, supported models), and evaluations. Sibling of agent-card-readme-generator and mcp-server-readme-generator for the prompts side.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "mizcausevic-dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/mizcausevic-dev/prompt-provenance-readme-generator"
  },
  "keywords": [
    "prompt-provenance",
    "prompt-engineering",
    "readme",
    "markdown",
    "documentation",
    "ai-governance",
    "kinetic-gain-suite",
    "typescript"
  ],
  "bin": {
    "prompt-provenance-readme-generator": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "demo": "tsx src/cli.ts fixtures/provenance.json",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
